# AdClarity environment variables
# Copy to .env.local and fill in values. Never commit real values.

# ---------- Shared ----------
NODE_ENV=
PORT=

# ---------- Database (Supabase) ----------
# Session mode pooler (port 5432) for migrations
DATABASE_URL=
# Transaction mode pooler (port 6543) for runtime
DATABASE_POOL_URL=

# ---------- Supabase ----------
# Public (frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only — NEVER expose to frontend
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---------- Frontend (Vite) ----------
BASE_PATH=
BASE_URL=
